# Copy to .env and edit. Every setting is optional.

# mock = free simulated AI (default). claude = real Claude (needs ANTHROPIC_API_KEY).
RTS_AI_PROVIDER=mock
# ANTHROPIC_API_KEY=sk-ant-...      # never commit this file with a real key

# Skip tailoring when the fit score is below this (0-100). 40 skips only clear mismatches.
RTS_MIN_FIT=40

# Resumes processed at the same time.
RTS_WORKERS=4

# Seconds each mock stage pauses, to make progress visible in the UI. 0 for instant.
RTS_MOCK_DELAY=0.3

# 1 = also produce PDF and verify page count (needs LibreOffice installed). 0 = Word only.
RTS_PDF=1

# Keep 0 in production: illustrative mode generates labelled example content, not real history.
RTS_ALLOW_ILLUSTRATIVE=0

# Time zone for "today" and "this week" counts.
RTS_TIMEZONE=America/New_York

# Set to 1 when the site is served over HTTPS.
RTS_SECURE_COOKIES=0

RTS_DB=data/app.db
RTS_FILES=data/files
RTS_HOST=127.0.0.1
RTS_PORT=8000

# Google Drive (see README "Google Drive"). Leave empty to disable.
RTS_GOOGLE_CLIENT_ID=
RTS_GOOGLE_CLIENT_SECRET=

# The address people use to open the app. Default http://localhost:8000. Set when hosting online.
# RTS_PUBLIC_URL=https://resumes.example.com
