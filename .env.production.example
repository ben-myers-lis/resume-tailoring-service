# Production settings. Copy to .env on the server (never commit it) or enter them in your host's dashboard.

# --- Required ---
# The address people use to open the app (HTTPS). Also used for the Google Drive redirect.
RTS_PUBLIC_URL=https://resumes.example.com
# Cookies only over HTTPS.
RTS_SECURE_COOKIES=1
# Your hosting provider's proxy terminates HTTPS; trust its forwarded headers.
RTS_FORWARDED_ALLOW_IPS=*
# Required to create the first administrator account. Use a long random value; you can remove it afterwards.
RTS_SETUP_CODE=change-me-to-a-long-random-value

# --- AI ---
# mock = free placeholder resumes; claude = real tailoring (needs the key below)
RTS_AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Drive (optional) ---
RTS_GOOGLE_CLIENT_ID=
RTS_GOOGLE_CLIENT_SECRET=

# --- Behaviour ---
RTS_TIMEZONE=America/New_York
RTS_MIN_FIT=40
RTS_WORKERS=4
RTS_PDF=1
RTS_ALLOW_ILLUSTRATIVE=0

# --- Storage (keep on a persistent disk) ---
RTS_DB=/app/data/app.db
RTS_FILES=/app/data/files
